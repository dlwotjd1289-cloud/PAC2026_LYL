diff -ruN a/scripts/moveit_prepare_v46.py b/scripts/moveit_prepare_v46.py
--- a/scripts/moveit_prepare_v46.py	1970-01-01 09:00:00.000000000 +0900
+++ b/scripts/moveit_prepare_v46.py	2026-10-10 10:32:07.739420551 +0900
@@ -0,0 +1,34 @@
+#!/usr/bin/env python3
+"""Before the first box: load the workcell planning scene into MoveIt and move the empty arm to
+READY (above PICK, cup down), so RViz shows the cell and the first pick starts from the pick pose.
+Requires Gazebo V4.6 and hdr50_moveit_v44.launch.py running. Commands only the robot arm."""
+import sys
+
+import rclpy
+from rclpy.signals import SignalHandlerOptions
+
+from moveit_pick_place_v44 import SCENE, Failure, MoveItPickPlace, box_object
+
+
+def main():
+    rclpy.init(signal_handler_options=SignalHandlerOptions.NO)
+    node = MoveItPickPlace()
+    try:
+        if not node.move_ac.wait_for_server(timeout_sec=20.0) or not node.scene_cli.wait_for_service(timeout_sec=20.0):
+            raise Failure("move_group not available")
+        node.apply_scene(objects=[box_object(n, c, s) for n, c, s in SCENE])
+        print(f">>> [MoveIt 준비] 작업셀 환경 {len(SCENE)}개 충돌 물체 등록", flush=True)
+        node.spin_for(1.0)
+        node.go_ready("move to READY above PICK (start)")
+        print(">>> [MoveIt 준비] 대기 자세(READY, PICK 위) 이동 완료", flush=True)
+        return 0
+    except Failure as exc:
+        print(f"MOVEIT PREPARE FAIL: {exc}", flush=True)
+        return 1
+    finally:
+        node.destroy_node()
+        rclpy.shutdown()
+
+
+if __name__ == "__main__":
+    sys.exit(main())
